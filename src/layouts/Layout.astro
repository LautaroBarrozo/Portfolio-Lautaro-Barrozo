---
export interface Props {
  title?: string;
  description?: string;
}
const { title = 'Mi Portfolio', description = 'Portfolio personal — desarrollo de software' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💻</text></svg>" />
  </head>
  <body class="bg-base-950 font-sans antialiased overflow-x-hidden selection:bg-accent-500/40 selection:text-white">
    <slot />
    <script src="../scripts/scroll-reveal.js"></script>
  </body>
</html>
