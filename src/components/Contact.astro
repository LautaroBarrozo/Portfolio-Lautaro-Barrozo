---
---
<section id="contacto" class="relative py-28 px-6 bg-base-900 overflow-hidden">
  <div class="absolute bottom-0 left-1/4 w-80 h-80 bg-glow-cyan/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-2xl mx-auto reveal">
    <div class="text-center mb-12">
      <p class="text-accent-400 font-display tracking-widest text-sm uppercase mb-3">Hablemos</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-white">Contacto</h2>
      <p class="mt-4 text-gray-400">
        ¿Tenés un proyecto en mente o querés charlar? Escribime.
      </p>
    </div>

    <!--
      IMPORTANTE: para que este formulario envíe el mail sin backend propio,
      creá una cuenta gratis en https://formspree.io, generá un formulario
      y reemplazá "TU_FORM_ID" de la línea de abajo por el ID que te den.
      También podés usar EmailJS o tu propio backend si preferís.
    -->
    <form
      id="contact-form"
      action="https://formspree.io/f/xkjgrlyp"
      method="POST"
      class="space-y-5 rounded-2xl border border-white/10 bg-base-800/60 p-8"
    >
      <div>
        <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Nombre</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-lg bg-base-950 border border-white/10 px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-accent-500 transition-all"
          placeholder="Tu nombre"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full rounded-lg bg-base-950 border border-white/10 px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-accent-500 transition-all"
          placeholder="tu@email.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-300 mb-2">Mensaje</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          class="w-full rounded-lg bg-base-950 border border-white/10 px-4 py-3 text-white placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-accent-500 transition-all resize-none"
          placeholder="Contame en qué puedo ayudarte..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-3 rounded-lg bg-accent-500 hover:bg-accent-600 text-white font-semibold transition-all hover:scale-[1.02] shadow-[0_0_30px_-8px_rgba(139,92,246,0.8)]"
      >
        Enviar mensaje
      </button>

      <p id="form-status" class="text-center text-sm mt-2 hidden"></p>
    </form>

    <div class="mt-10 flex justify-center gap-6 text-gray-500">
      <a href="https://github.com/LautaroBarrozo" target="_blank" class="hover:text-white transition-colors">GitHub</a>
      <a href="https://www.linkedin.com/in/lautaro-barrozo-38b51b23b/" target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    const data = new FormData(form);
    status.classList.remove('hidden');
    status.textContent = 'Enviando...';
    status.className = 'text-center text-sm mt-2 text-gray-400';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        status.textContent = '¡Mensaje enviado! Te voy a responder pronto.';
        status.className = 'text-center text-sm mt-2 text-green-400';
        form.reset();
      } else {
        throw new Error('Error en el envío');
      }
    } catch {
      status.textContent = 'No se pudo enviar. Probá de nuevo o escribime directamente por mail.';
      status.className = 'text-center text-sm mt-2 text-red-400';
    }
  });
</script>
